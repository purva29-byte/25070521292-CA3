# Server
NODE_ENV=development
PORT=5000

# Database (Connect via MongoDB Compass or local MongoDB)
MONGODB_URI=mongodb://127.0.0.1:27017/unimarket
# Compass connection string: mongodb://127.0.0.1:27017/unimarket

# Authentication — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
COOKIE_SECRET=replace-with-another-long-random-secret
COOKIE_SAMESITE=lax

# Frontend origin allowed by CORS
CLIENT_URL=http://localhost:5173

# Uploads
MAX_IMAGE_SIZE_MB=5
MAX_IMAGES_PER_LISTING=6

# Bootstrap / demo admin (used by npm run seed and npm run create-admin)
SEED_ADMIN_NAME=UniMarket Admin
SEED_ADMIN_EMAIL=admin@unimarket.demo
SEED_ADMIN_PASSWORD=Admin@12345

# Optional SMTP for password-reset emails. Leave blank to disable.
# The API returns a clear 503 instead of pretending an email was sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=UniMarket <no-reply@example.com>
